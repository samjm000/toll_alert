{
  "expo": {
    "name": "Toll Alert",
    "slug": "toll_alert",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "infoPlist": {
        "UIBackgroundModes": [
          "location"
        ],
        "NSLocationWhenInUseUsageDescription": "Toll Alert checks your location to detect when you've crossed the Dartford Crossing or entered the ULEZ, so it can remind you to pay.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Toll Alert needs \"Always\" location access to detect toll crossings in the background, even when the app is closed, so you don't miss a payment deadline."
      },
      "bundleIdentifier": "com.tollalert.app",
      "icon": "./assets/icon-ios.png",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "icon": "./assets/icon.png",
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION",
        "android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "package": "uk.co.tollalert.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "experiments": {
      "baseUrl": "/toll_alert"
    },
    "plugins": [
      "expo-dev-client",
      "expo-task-manager",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Toll Alert needs \"Always\" location access to detect toll crossings in the background, even when the app is closed, so you don't miss a payment deadline.",
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/logo-mark.png",
          "color": "#F3B815"
        }
      ],
      "./plugins/withSceneDelegate",
      "expo-background-task"
    ],
    "extra": {
      "diagnostics": {
        "uploadUrl": "https://script.google.com/macros/s/AKfycbxPdhr5Xb1GVAMlCHIBrYk-f2VHobD0BGKpTn_h65ksX1YmO-i0M51dwLQlcv4rDxA4/exec",
        "uploadToken": "aprPjYoebqexqFoEPust0U3a",
        "defaultEnabled": true
      },
      "eas": {
        "projectId": "d8725cc4-820d-4898-9e31-7f0b8d4d2f8d"
      }
    },
    "owner": "samjm001"
  }
}
